# Advisory warnings; run by pre-push and CI via tools/check-cpp.mjs.
# Analysis needs the correct Windows compiler flags and headers.
Checks: >-
  -*,
  clang-analyzer-*,
  bugprone-*,
  google-*,
  -google-objc-*,
  performance-*
WarningsAsErrors: ''
HeaderFilterRegex: '(^|[/\\])networking[/\\]'
FormatStyle: Google
